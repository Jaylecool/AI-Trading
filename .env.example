# =============================================================================
# AI Trading System - Environment Configuration
# Copy this file to .env and update values for your environment
# =============================================================================

# --- Flask Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# --- Trading ---
INITIAL_CAPITAL=100000
SUPPORTED_SYMBOLS=AAPL,NVDA,MSFT,GOOGL,AMZN,TSLA,META

# --- CORS (comma-separated allowed origins, or * for all) ---
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- ngrok (optional, for public access) ---
NGROK_DOMAIN=

# --- SMTP Email Notifications (optional) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=

# --- Streaming ---
STREAM_UPDATE_FREQUENCY=2

# --- Alpaca Live Trading ---
# Get keys from https://alpaca.markets (free account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Set to false to switch to LIVE trading (real money). Default is paper trading.
ALPACA_PAPER=true
